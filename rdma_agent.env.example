# ============================================================
# RDMA Agent System - Environment Configuration
# Copy this to .env and update values for your environment
# ============================================================

# ── LLM Model (OpenAI-compatible API) ──────────────────────
LLM_API_BASE=http://localhost:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL_NAME=your-llm-model
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# ── Embedding Model (OpenAI-compatible API) ─────────────────
EMBEDDING_API_BASE=http://localhost:8081/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL_NAME=your-embedding-model
EMBEDDING_DIMENSION=1024

# ── Rerank Model (OpenAI-compatible API) ────────────────────
RERANK_API_BASE=http://localhost:8082/v1
RERANK_API_KEY=not-needed
RERANK_MODEL_NAME=your-rerank-model
RERANK_TOP_N=5

# ── Dify.ai Platform ───────────────────────────────────────
# Leave empty to use local ChromaDB mode instead of Dify
DIFY_API_BASE=http://localhost:5001/v1
DIFY_API_KEY=app-xxxxxxxxxxxxx
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxx

# ── Monitoring ──────────────────────────────────────────────
MONITOR_POLL_INTERVAL=30
LOG_RETENTION_HOURS=168
ALERT_COOLDOWN=300
MAX_RETRY_ACTIONS=3

# ── Alarm / Escalation ─────────────────────────────────────
# Webhook (Slack, Teams, DingTalk, etc.)
ALARM_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Email
ALARM_SMTP_HOST=smtp.gmail.com
ALARM_SMTP_PORT=587
ALARM_EMAIL_FROM=rdma-agent@yourcompany.com
ALARM_EMAIL_TO=oncall-team@yourcompany.com
ALARM_EMAIL_PASSWORD=your-app-password

# ── Application ─────────────────────────────────────────────
RDMA_DATA_DIR=/var/lib/rdma_agent
RDMA_LOG_DIR=/var/log/rdma_agent
RDMA_AGENT_HOST=0.0.0.0
RDMA_AGENT_PORT=8900
